---
import { CF_IMAGES, SITE } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  faq?: { question: string; answer: string }[];
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = CF_IMAGES.og,
  noindex = false,
  faq = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE.url).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en-US',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Phoenix',
        addressRegion: 'AZ',
        addressCountry: 'US',
      },
    },
    // Domain listing as Service + AggregateOffer (not Product).
    // Product markup triggered Search Console critical "price" / "priceCurrency"
    // errors and non-critical aggregateRating/review warnings. Fabricating
    // reviews violates Google spam policies; this page has no real reviews.
    {
      '@type': 'Service',
      '@id': `${SITE.url}/#domain`,
      name: 'PHX.Contact Premium Domain',
      description:
        'Premium ultra-short .contact domain for Phoenix. Ideal for contact platforms, lead generation, real estate tech, or premium local branding.',
      category: 'Domain Name',
      image: ogImageUrl,
      provider: { '@id': `${SITE.url}/#organization` },
      offers: {
        '@type': 'AggregateOffer',
        '@id': `${SITE.url}/#domain-offer`,
        priceCurrency: SITE.valuation.currency,
        lowPrice: SITE.valuation.low,
        highPrice: SITE.valuation.high,
        offerCount: 1,
        availability: 'https://schema.org/InStock',
        url: SITE.url,
        seller: { '@id': `${SITE.url}/#organization` },
        shippingDetails: {
          '@type': 'OfferShippingDetails',
          shippingRate: {
            '@type': 'MonetaryAmount',
            value: '0.00',
            currency: 'USD',
          },
          deliveryTime: {
            '@type': 'ShippingDeliveryTime',
            handlingTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 1,
              unitCode: 'DAY',
            },
            transitTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 0,
              unitCode: 'DAY',
            },
          },
          shippingDestination: {
            '@type': 'DefinedRegion',
            addressCountry: 'US',
          },
        },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
          applicableCountry: 'US',
          merchantReturnDays: 0,
        },
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#domain` },
      inLanguage: 'en-US',
      dateModified: SITE.lastUpdated,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Why this domain', item: `${SITE.url}/#why` },
        { '@type': 'ListItem', position: 3, name: 'Opportunity', item: `${SITE.url}/#opportunity` },
        { '@type': 'ListItem', position: 4, name: 'Strategic value', item: `${SITE.url}/#value` },
        { '@type': 'ListItem', position: 5, name: 'FAQ', item: `${SITE.url}/#faq` },
        { '@type': 'ListItem', position: 6, name: 'Acquire', item: `${SITE.url}/#acquire` },
      ],
    },
    ...(faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: { '@type': 'Answer', text: item.answer },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PHX.Contact — Premium Phoenix .contact domain for acquisition" />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="PHX.Contact — Premium Phoenix .contact domain for acquisition" />

    <!-- Theme -->
    <meta name="theme-color" content="#0F172A" />
    <meta name="color-scheme" content="light" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Fonts: stylesheet link (non-blocking) replaces CSS @import for faster LCP -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
    <link
      rel="preload"
      as="image"
      href={CF_IMAGES.hero}
      fetchpriority="high"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {SITE.cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${SITE.cfBeaconToken}"}`}
      />
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-white focus:text-slate-900 focus:px-4 focus:py-2 focus:rounded-xl focus:text-sm focus:font-semibold"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
