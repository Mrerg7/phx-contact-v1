---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
}

const {
  src,
  alt,
  width = 1200,
  height = 630,
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = '100vw',
} = Astro.props;

// NOTE: Do not fabricate Cloudflare Images variant URLs (e.g. `/w=640`).
// Undeclared variants return 403 and break `srcset` candidates. The `public`
// variant below is verified 200. If resized variants are needed, create them
// in the Cloudflare Images dashboard (paid account) and pass full URLs here.
function resolveCfImageUrl(base: string): string {
  const match = base.match(
    /^https:\/\/imagedelivery\.net\/([^/]+)\/([^/]+)(?:\/([^/]+))?$/,
  );
  if (!match) return base;
  const [, account, id, variant = 'public'] = match;
  return `https://imagedelivery.net/${account}/${id}/${variant}`;
}

const imageSrc = resolveCfImageUrl(src);
---

<img
  src={imageSrc}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  sizes={sizes}
  class={className}
/>
