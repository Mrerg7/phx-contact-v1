---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  responsive?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  width = 1200,
  height = 630,
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  responsive = false,
  sizes = '100vw',
} = Astro.props;

function resolveCfImageUrl(base: string): string {
  const match = base.match(
    /^https:\/\/imagedelivery\.net\/([^/]+)\/([^/]+)(?:\/([^/]+))?$/,
  );
  if (!match) return base;
  const [, account, id, variant = 'public'] = match;
  return `https://imagedelivery.net/${account}/${id}/${variant}`;
}

function variantUrl(base: string, w: number): string {
  const match = base.match(/^https:\/\/imagedelivery\.net\/([^/]+)\/([^/]+)(?:\/[^/]+)?$/);
  if (!match) return base;
  const [, account, id] = match;
  return `https://imagedelivery.net/${account}/${id}/w=${w}`;
}

const imageSrc = resolveCfImageUrl(src);
const srcset = responsive
  ? [640, 960, 1280, 1920].map((w) => `${variantUrl(src, w)} ${w}w`).join(', ')
  : undefined;
---

<img
  src={imageSrc}
  srcset={srcset}
  sizes={responsive ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={className}
/>
