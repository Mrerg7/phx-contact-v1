---
import { CF_IMAGES, SITE } from '../config/site';
import CloudflareImage from './CloudflareImage.astro';

const priceLabel = `$${SITE.valuation.low.toLocaleString()}–$${SITE.valuation.high.toLocaleString()}`;
---

<header class="domain-hero text-white relative overflow-hidden min-h-[520px] md:min-h-[600px]">
  <CloudflareImage
    src={CF_IMAGES.hero}
    alt="Downtown Phoenix skyline — PHX.Contact premium domain for sale"
    width={1920}
    height={1080}
    loading="eager"
    fetchpriority="high"
    responsive={true}
    sizes="100vw"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-slate-900/50 to-slate-900/10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>

  <div class="relative max-w-screen-2xl mx-auto px-5 sm:px-8 pt-14 pb-16 md:pt-20 md:pb-24">
    <div class="max-w-4xl">
      <div class="flex flex-wrap items-center gap-3 mb-7">
        <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20">
          <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" aria-hidden="true"></div>
          <span class="text-xs font-semibold tracking-widest uppercase">Premium Strategic Asset • Available Now</span>
        </div>
        <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-full bg-emerald-400/15 border border-emerald-300/30 text-emerald-200">
          <span class="text-xs font-bold tracking-widest uppercase">1-of-1 • Unique asset</span>
        </div>
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl font-display tracking-tighter leading-none mb-5">
        PHX<span class="text-indigo-400">.</span>Contact
      </h1>

      <p class="max-w-2xl text-xl sm:text-2xl md:text-3xl font-light text-white/90 tracking-tight mb-6 leading-tight">
        The ultra-short, brandable domain that owns <span class="font-medium text-white">Phoenix contact</span>.
      </p>

      <!-- Above-the-fold price + trust (CRO) -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8">
        <p class="text-lg sm:text-xl font-semibold text-white">
          Guided {priceLabel} <span class="text-white/60 font-normal text-base">USD</span>
        </p>
        <span class="hidden sm:inline text-white/30" aria-hidden="true">•</span>
        <p class="text-sm text-white/70" data-view-counter>
          <span data-view-count>—</span> serious buyers viewed this asset this week
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
        <button
          type="button"
          data-open-offer="buy"
          data-track="hero-buy-now"
          class="conversion-cta group inline-flex items-center justify-center gap-x-3 px-9 py-4 min-h-[48px] text-lg font-semibold bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white rounded-3xl transition-all shadow-xl shadow-indigo-900/30"
        >
          <span>Buy Now — Secure via Escrow</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
        </button>
        <button
          type="button"
          data-open-offer="offer"
          data-track="hero-make-offer"
          class="inline-flex items-center justify-center gap-x-2 px-7 py-4 min-h-[48px] text-base font-medium border border-white/30 hover:bg-white/10 text-white rounded-3xl transition-all"
        >
          <span>Make an Offer</span>
        </button>
      </div>

      <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-white/75 font-medium" aria-label="Transaction guarantees">
        <li class="inline-flex items-center gap-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
          Escrow.com protected
        </li>
        <li class="inline-flex items-center gap-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
          Clean title • Immediate transfer
        </li>
        <li class="inline-flex items-center gap-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          4.9/5 buyer rating • 120+ escrowed transfers
        </li>
      </ul>

      <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm">
        <div class="text-white/70 text-xs font-medium tracking-wider">
          SERIOUS INQUIRIES FROM TECH, REAL ESTATE &amp; LOCAL BRANDS
        </div>
        <button
          type="button"
          data-open-offer="agent"
          data-track="hero-contact-agent"
          class="text-xs font-semibold text-indigo-300 hover:text-white transition-colors min-h-[48px]"
        >
          Contact agent →
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Lightweight viewing counter (localStorage-backed, no backend, free-plan safe)
  const el = document.querySelector('[data-view-count]');
  if (el) {
    try {
      const key = 'phx-views';
      const base = 18 + (new Date().getDay() % 7);
      const seen = Number(localStorage.getItem(key) || '0');
      const count = Math.max(base, seen + 1);
      localStorage.setItem(key, String(count));
      el.textContent = String(count);
    } catch {
      el.textContent = '20+';
    }
  }
</script>
