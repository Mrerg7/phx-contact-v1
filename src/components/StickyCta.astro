---

<!-- Sticky mobile CTA (appears after hero) + back-to-top -->
<div
  id="sticky-cta"
  class="fixed bottom-0 inset-x-0 z-[90] md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-md px-4 pt-3"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));"
>
  <div class="flex gap-2">
    <button
      type="button"
      data-open-offer="offer"
      class="flex-1 inline-flex items-center justify-center px-4 py-3 min-h-[48px] text-sm font-semibold rounded-2xl border border-slate-300"
    >
      Make Offer
    </button>
    <button
      type="button"
      data-open-offer="buy"
      class="flex-1 inline-flex items-center justify-center px-4 py-3 min-h-[48px] text-sm font-semibold rounded-2xl bg-indigo-600 text-white"
    >
      Buy Now
    </button>
  </div>
</div>

<button
  id="to-top"
  type="button"
  class="hidden fixed bottom-6 right-6 z-[90] w-12 h-12 items-center justify-center rounded-full bg-slate-900 text-white shadow-xl hover:bg-black transition-colors"
  aria-label="Back to top"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd" /></svg>
</button>

<script>
  const sticky = document.getElementById('sticky-cta');
  const toTop = document.getElementById('to-top');

  function onScroll() {
    const y = window.scrollY || 0;
    const showSticky = y > window.innerHeight * 0.7;
    sticky?.classList.toggle('is-visible', showSticky);
    const showTop = y > window.innerHeight * 1.5;
    if (toTop) {
      toTop.classList.toggle('hidden', !showTop);
      toTop.classList.toggle('flex', showTop);
    }
    // Reveal-on-scroll
    document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight * 0.9) el.classList.add('is-visible');
    });
  }

  // Tag static sections for entrance animation
  document.querySelectorAll('main section, main header').forEach((el) => el.classList.add('reveal'));
  // Hero should be visible immediately (LCP)
  document.querySelector('main header')?.classList.add('is-visible');

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
