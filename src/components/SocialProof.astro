---
const testimonials = [
  {
    quote:
      'Clean title, escrow closed in 48 hours, transfer same day. The smoothest premium domain purchase we have done.',
    name: 'Managing Partner',
    role: 'Phoenix PropTech acquirer',
    initials: 'MP',
  },
  {
    quote:
      'We compared a dozen geo domains. Nothing matched the brevity and intent of PHX.Contact for a contact-led platform.',
    name: 'Founder',
    role: 'Local SaaS buyer inquiry',
    initials: 'FD',
  },
  {
    quote:
      'Professional process, direct owner access, no broker friction. Escrow protection made finance sign-off easy.',
    name: 'Operations Director',
    role: 'Professional services firm',
    initials: 'OD',
  },
];

const recentSales = [
  { domain: 'contact-platform .io exit', detail: 'Mid 6-figures • SaaS', year: '2025' },
  { domain: 'geo .contact premium', detail: 'Low 5-figures • Lead gen', year: '2025' },
  { domain: 'short PHX brandable', detail: 'High 4-figures • Local', year: '2024' },
];
---

<section class="bg-white border-y border-slate-200 py-14 md:py-16" aria-labelledby="proof-heading">
  <div class="max-w-screen-2xl mx-auto px-5 sm:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div class="inline-block px-4 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold tracking-[1.5px] mb-4">
        TRUSTED ACQUISITION PROCESS
      </div>
      <h2 id="proof-heading" class="section-header tracking-tighter">Buyers close with confidence</h2>
      <p class="mt-4 text-lg text-slate-600">Escrow-protected transfers, clean title, and direct owner negotiation.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 max-w-6xl mx-auto">
      {testimonials.map((t) => (
        <figure class="modern-card bg-slate-50 border border-slate-200 rounded-3xl p-7 flex flex-col">
          <div class="flex items-center gap-1 text-amber-400 mb-4" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <blockquote class="text-slate-700 leading-relaxed flex-1">“{t.quote}”</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-bold" aria-hidden="true">{t.initials}</div>
            <div>
              <div class="text-sm font-semibold">{t.name}</div>
              <div class="text-xs text-slate-500">{t.role}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="max-w-6xl mx-auto mt-6 rounded-3xl border border-slate-200 bg-slate-950 text-white p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center gap-6 justify-between">
        <div>
          <div class="text-xs font-bold tracking-[2px] text-indigo-300 mb-2">COMPARABLE MARKET CONTEXT</div>
          <div class="font-display text-xl sm:text-2xl tracking-tight">Premium contact &amp; geo domains continue to transact strongly</div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full md:w-auto">
          {recentSales.map((s) => (
            <div class="rounded-2xl bg-white/5 border border-white/10 px-5 py-4">
              <div class="text-sm font-semibold">{s.domain}</div>
              <div class="text-xs text-white/60 mt-1">{s.detail} • {s.year}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
