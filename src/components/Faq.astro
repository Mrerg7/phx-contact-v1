---
export interface FaqItem {
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    question: 'How much is PHX.Contact listed for?',
    answer:
      'Guided $35,000–$65,000 USD depending on use, timeline, and terms. All serious offers are considered; offers above $40,000 receive priority review. Transactions close via Escrow.com or Dan.com.',
  },
  {
    question: 'How does the secure purchase process work?',
    answer:
      'Submit an offer or start Buy Now, agree on price and escrow provider, fund escrow, then the domain is pushed or transferred via authorization code. Funds release only after you confirm control of the domain.',
  },
  {
    question: 'Is PHX.Contact a premium investment domain?',
    answer:
      'Yes. It is a 10-character, ultra-short geo + exact-match .contact asset: PHX is the universal shorthand for Phoenix, and .contact carries direct commercial intent for lead generation, CRM, and contact platforms. Short geo-keyword domains of this quality are scarce and historically hold value in top growth metros.',
  },
  {
    question: 'Can I buy .contact domains for lead generation or real estate?',
    answer:
      'That is the ideal use. PHX.Contact suits local lead-generation platforms, business contact directories, real estate tech, SaaS contact tools, marketing agencies, and professional-services branding across the 5M+ Phoenix metro.',
  },
  {
    question: 'How fast is transfer and what guarantees do I get?',
    answer:
      'Transfer typically completes within 1–3 business days after escrow funds clear. You get clean title, escrow buyer protection, and a written transfer confirmation. Response to qualified inquiries is within 24 hours.',
  },
  {
    question: 'Do you offer payment plans or broker introductions?',
    answer:
      'Short-term escrow-held payment plans can be discussed for qualified buyers. If you work with a broker, have them email sales@desertrich.com with proof of funds or mandate and we will cooperate.',
  },
];
---

<section id="faq" class="max-w-screen-2xl mx-auto px-5 sm:px-8 py-16 md:py-20 scroll-mt-24">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <div class="inline-block px-4 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold tracking-[1.5px] mb-4">
        BUYER QUESTIONS • ANSWERED
      </div>
      <h2 class="section-header tracking-tighter">Premium domain FAQ</h2>
      <p class="mt-4 text-lg text-slate-600">
        Everything serious buyers ask before acquiring a premium .contact investment domain.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((item) => (
        <details class="faq-item group bg-white border border-slate-200 rounded-2xl open:border-indigo-200 transition-colors">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 min-h-[48px] font-semibold text-left tracking-tight">
            <span>{item.question}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="faq-chevron h-5 w-5 shrink-0 text-indigo-600 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="px-6 pb-6 text-slate-600 leading-relaxed">{item.answer}</div>
        </details>
      ))}
    </div>

    <nav class="mt-10 flex flex-wrap justify-center gap-2 text-sm" aria-label="Related sections">
      <a href="#why" class="px-4 py-2 min-h-[48px] inline-flex items-center rounded-full border border-slate-200 bg-white hover:border-indigo-300 hover:text-indigo-700 transition-colors">Why this domain</a>
      <a href="#opportunity" class="px-4 py-2 min-h-[48px] inline-flex items-center rounded-full border border-slate-200 bg-white hover:border-indigo-300 hover:text-indigo-700 transition-colors">Investment paths</a>
      <a href="#value" class="px-4 py-2 min-h-[48px] inline-flex items-center rounded-full border border-slate-200 bg-white hover:border-indigo-300 hover:text-indigo-700 transition-colors">Strategic value</a>
      <a href="#acquire" class="px-4 py-2 min-h-[48px] inline-flex items-center rounded-full border border-slate-200 bg-white hover:border-indigo-300 hover:text-indigo-700 transition-colors">How to acquire</a>
    </nav>
  </div>
</section>
